# Thirdweb client - public client id from https://thirdweb.com/dashboard
VITE_THIRDWEB_CLIENT_ID=

# Optional Base RPC (defaults to public Base RPC)
VITE_RPC_URL=

# SIWE stub - long random string for challenge + session JWTs (dev server only)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional ERC-20 on Base (leave empty for native ETH only)
VITE_TOKEN_ADDRESS=
VITE_TOKEN_SYMBOL=
VITE_TOKEN_DECIMALS=18

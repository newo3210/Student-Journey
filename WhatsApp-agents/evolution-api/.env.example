# Evolution API WhatsApp agent — local demo (never commit real secrets)
#
# Disclaimer: Evolution is an unofficial WhatsApp gateway. Using it may violate
# Meta Terms of Service and risk account bans. Educational / demo use only.

# Required — Evolution API base URL (Compose service default below)
EVOLUTION_API_URL=http://evolution-api:8080

# Required — Evolution authentication API key (must match Evolution AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY=change-me-evolution-apikey

# Required — Evolution instance name (create/connect instance in Evolution dashboard)
EVOLUTION_INSTANCE=student-demo

# Optional — HTTP listen port for this bot (default 3001)
PORT=3001

# Optional — Public HTTPS URL for coupon image/document (placeholder OK for unit tests)
COUPON_MEDIA_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf

# Optional — Evolution REST path style pin (documented v2 routes in README)
EVOLUTION_API_VERSION=v2

# Optional — Humanization delay overrides (milliseconds).
# Production (Dockerfile NODE_ENV=production) requires MIN>=20000 and MAX>=45000.
# Tests / local NODE_ENV=test may use 0/0 with injected sleep.
HUMANIZE_MIN_MS=20000
HUMANIZE_MAX_MS=45000

# Optional — Shared secret for POST /webhook header `x-webhook-secret`.
# When set, missing/mismatched header → 401/403 and no Evolution send.
# When unset, any client that can reach /webhook can forge inbound (send-oracle on a public tunnel).
EVOLUTION_WEBHOOK_SECRET=

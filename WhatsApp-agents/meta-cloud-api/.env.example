# Meta WhatsApp Cloud API — local demo (never commit real secrets)

# Required — Graph API access token from Meta Developer Console
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token

# Required — Phone number ID (not the display phone number)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Required — Verify token you choose; must match Meta webhook subscription
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# Optional — App secret for X-Hub-Signature-256 (strongly recommended for public tunnels)
# When set, POST /webhook rejects missing/invalid signatures before calling Graph.
# Leaving unset keeps unsigned demo mode — unsafe on public HTTPS tunnels (forged inbound → token abuse).
WHATSAPP_APP_SECRET=your_app_secret_recommended

# Optional — HTTP listen port (default 3000)
PORT=3000

# Optional — Graph API version pin (default v21.0)
META_GRAPH_API_VERSION=v21.0

# Optional — Public HTTPS URL for coupon image/document (placeholder OK for unit tests)
COUPON_MEDIA_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf

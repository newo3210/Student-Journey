# WhatsMeow WhatsApp agent — local demo (never commit real secrets)
#
# Disclaimer: WhatsMeow is an unofficial WhatsApp multi-device library.
# Using it may violate Meta Terms of Service and risk account bans.
# Educational / demo use only. Default menu is numbered text.

# Required — folder for SQL/session store (QR / device). Gitignored. Interactive pairing.
WHATSMEOW_STORE_DIR=./whatsmeow_store

# Optional — HTTP listen port for the inbound simulator + health (default 3004)
PORT=3004

# Optional — Public HTTPS URL for coupon image/document (placeholder OK for unit tests)
COUPON_MEDIA_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf

# Optional — Menu style. Default `text` (numbered). `buttons` / `list` fall back to text.
WHATSMEOW_MENU_MODE=text

# Optional — Humanization delay overrides (milliseconds).
# Production (Dockerfile GO_ENV/NODE_ENV=production) requires MIN>=20000 and MAX>=45000.
# Tests / local GO_ENV=test may use 0/0 with injected sleep.
HUMANIZE_MIN_MS=20000
HUMANIZE_MAX_MS=45000

# Optional locally; **required** when GO_ENV/NODE_ENV=production (Docker default).
# When set, POST /webhook must send header x-webhook-secret.
# When unset (development), any client that can reach /webhook can forge inbound.
WHATSMEOW_WEBHOOK_SECRET=

# Optional — production | test | development (production enforces delay floor)
GO_ENV=development
NODE_ENV=

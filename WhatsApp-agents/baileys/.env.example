# Baileys WhatsApp agent — local demo (never commit real secrets)
#
# Disclaimer: Baileys is an unofficial WhatsApp Web multi-device socket library.
# Using it may violate Meta Terms of Service and risk account bans.
# Educational / demo use only. Native buttons are unstable — default menu is numbered text.

# Required — folder for multi-file auth state (QR / creds). Gitignored. Interactive pairing.
BAILEYS_AUTH_DIR=./auth_info_baileys

# Optional — HTTP listen port for the inbound simulator + health (default 3003)
PORT=3003

# Optional — Public HTTPS URL for coupon image/document (placeholder OK for unit tests)
COUPON_MEDIA_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf

# Optional — Menu style. Default `text` (numbered). `buttons` / `list` are documented as unstable on Baileys.
BAILEYS_MENU_MODE=text

# Optional — Humanization delay overrides (milliseconds).
# Production (Dockerfile NODE_ENV=production) requires MIN>=20000 and MAX>=45000.
# Tests / local NODE_ENV=test may use 0/0 with injected sleep.
HUMANIZE_MIN_MS=20000
HUMANIZE_MAX_MS=45000

# Optional — Shared secret for POST /webhook header `x-webhook-secret`.
# When set, missing/mismatched header → 401/403 and no adapter send.
# When unset, any client that can reach /webhook can forge inbound (send-oracle on a public tunnel).
# The HTTP /webhook is a TDD/simulator path — live inbound is the Baileys socket messages.upsert.
BAILEYS_WEBHOOK_SECRET=

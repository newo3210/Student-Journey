# Waha WhatsApp agent — local demo (never commit real secrets)
#
# Disclaimer: Waha is an unofficial WhatsApp HTTP API. Using it may violate
# Meta Terms of Service and risk account bans. Educational / demo use only.

# Required — Waha base URL (Compose service default below)
WAHA_API_URL=http://waha:3000

# Required — Waha API key (must match WAHA_API_KEY on the Waha container)
WAHA_API_KEY=00000000000000000000000000000000

# Required — Waha session name (scan QR / start session in Waha dashboard)
WAHA_SESSION=default

# Optional — HTTP listen port for this bot (default 3002; Waha uses 3000)
PORT=3002

# Optional — Public HTTPS URL for coupon image/document (placeholder OK for unit tests)
COUPON_MEDIA_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf

# Optional — Menu style. CORE image (`devlikeapro/waha`) does not reliably support
# sendButtons (deprecated) or sendList (GOWS/NOWEB PLUS). Default `text` is the
# documented fallback. Use `list` or `buttons` only if your Waha engine supports them.
WAHA_MENU_MODE=text

# Optional — Humanization delay overrides (milliseconds).
# Production (Dockerfile NODE_ENV=production) requires MIN>=20000 and MAX>=45000.
# Tests / local NODE_ENV=test may use 0/0 with injected sleep.
HUMANIZE_MIN_MS=20000
HUMANIZE_MAX_MS=45000

# Optional — Shared secret for POST /webhook header `x-webhook-secret`.
# When set, missing/mismatched header → 401/403 and no Waha send.
# When unset, any client that can reach /webhook can forge inbound (send-oracle on a public tunnel).
# Point Waha at this bot with WHATSAPP_HOOK_CUSTOM_HEADERS=x-webhook-secret:<same value>
WAHA_WEBHOOK_SECRET=
